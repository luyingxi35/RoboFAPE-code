{
  "schema_version": 2,
  "task_id": "PegInsertionSide-v1",
  "task_description": "Pick up the peg, align its head with the side-facing hole, and insert it into the box.",
  "num_stage": 3,
  "observations": [
    {
      "name": "eef_pos",
      "source": "agent.tcp.pose",
      "argument": null,
      "transform": "position",
      "description": "Robot tool-center-point world position."
    },
    {
      "name": "peg_pos",
      "source": "env.peg.pose",
      "argument": null,
      "transform": "position",
      "description": "Peg center world position."
    },
    {
      "name": "peg_quat",
      "source": "env.peg.pose",
      "argument": null,
      "transform": "quaternion",
      "description": "Peg world orientation."
    },
    {
      "name": "peg_head_pos",
      "source": "env.peg_head_pose",
      "argument": null,
      "transform": "position",
      "description": "Peg insertion-tip world position."
    },
    {
      "name": "hole_pos",
      "source": "env.box_hole_pose",
      "argument": null,
      "transform": "position",
      "description": "Side-facing hole center position."
    },
    {
      "name": "hole_axis",
      "source": "env.box_hole_pose",
      "argument": null,
      "transform": "axis_x",
      "description": "Hole insertion axis in world coordinates."
    },
    {
      "name": "goal_pos",
      "source": "env.goal_pose",
      "argument": null,
      "transform": "position",
      "description": "Peg-center position at full insertion."
    },
    {
      "name": "goal_quat",
      "source": "env.goal_pose",
      "argument": null,
      "transform": "quaternion",
      "description": "Peg orientation aligned with the hole."
    },
    {
      "name": "grasped",
      "source": "agent.is_grasping",
      "argument": "env.peg",
      "transform": "boolean",
      "description": "Whether the robot currently grasps the peg."
    },
    {
      "name": "inserted",
      "source": "env.evaluate.success",
      "argument": null,
      "transform": "boolean",
      "description": "Authoritative side-insertion success predicate."
    }
  ],
  "stages": [
    {
      "stage": "reach",
      "failure_substages": [
        "reach",
        "grasp"
      ],
      "description": "Approach the peg until it is grasped.",
      "metric": "distance(eef_pos, peg_pos)",
      "direction": "decrease",
      "end_condition": "boolean_state(grasped) >= 1.0",
      "monotonic_expected": false,
      "rationale": "Current grasp state directly separates reach from post-grasp behavior."
    },
    {
      "stage": "pre_insert",
      "failure_substages": [
        "pre_insert"
      ],
      "description": "Transport the grasped peg toward the hole and align it for insertion.",
      "metric": "lateral_distance(peg_head_pos, hole_pos, hole_axis) + lateral_distance(peg_pos, goal_pos, hole_axis) + 0.05 * orientation_error(peg_quat, goal_quat)",
      "direction": "decrease",
      "end_condition": "boolean_state(grasped) >= 1.0 and lateral_distance(peg_head_pos, hole_pos, hole_axis) < 0.01 and lateral_distance(peg_pos, goal_pos, hole_axis) < 0.01",
      "monotonic_expected": false,
      "rationale": "The broad post-grasp stage includes transport and all failed alignment attempts."
    },
    {
      "stage": "insert",
      "failure_substages": [
        "insert",
        "plan",
        "motion_plan"
      ],
      "description": "Advance the aligned peg into the hole.",
      "metric": "distance(peg_head_pos, hole_pos) + 0.05 * orientation_error(peg_quat, goal_quat)",
      "direction": "decrease",
      "end_condition": "boolean_state(inserted) >= 1.0",
      "monotonic_expected": false,
      "rationale": "Insertion begins at the current-frame pre-insertion geometry, before final success."
    }
  ],
  "profile_adapter": "schema",
  "runtime": {
    "task_module": "PegInsertionSide",
    "solver": "PegInsertionSide:solve_peginsertionside",
    "max_episode_steps": 350,
    "robot": "panda_wristcam",
    "control_mode": "pd_joint_pos",
    "object": "peg",
    "main_camera": "render_camera",
    "wrist_camera": "hand_camera",
    "camera_size": 224,
    "render_size": 512,
    "sim_backend": "gpu",
    "action_dim": 8
  },
  "stage_order": [
    "reach",
    "pre_insert",
    "insert"
  ],
  "validation_status": "runtime_unverified"
}
